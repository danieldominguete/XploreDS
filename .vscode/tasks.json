{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Python File in Terminal",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -u ${file}",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUNBUFFERED": "1"
        },
        "envFile": "${workspaceFolder}/.env"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
